#!/usr/bin/python3 -I
"""Bound, scan, and assemble spar reviewer payloads without exposing rejected bytes.

Modes:
  outbound [--root DIR]... [--scratch-root DIR] -- [artifact-file...]  read the review request on
      stdin, read each artifact file, reject credential-shaped values and
      sensitive diff paths in any of them, and write the assembled prompt
      (request followed by one delimited section per artifact) on stdout. Every
      artifact must canonicalize under one of the roots, must not sit under a
      sensitive or Git-internal component, and must be a regular, single-link
      file owned by the current user. A scratch root must be a private owned
      directory below a temp root, not a shared tool root. Other tool sessions
      are excluded unless the artifact is inside that explicit caller scratch.
  reply  read a reviewer reply on stdin and reject credential-shaped values
  diff   read a Git diff on stdin and reject credential-shaped values and
      sensitive diff paths; the commit and publish skills run it over staged
      and outbound diffs before presenting a candidate or a push

Exit codes: 0 accepted, 2 rejected or malformed input, 64 usage. Diagnostics
name the rule and line, never the matched bytes.

Credential-like assignments can also describe path inventories. Only a
metadata-shaped name and a bounded, complete, flat literal collection of
recognized path/glob descriptors qualify for that exception. Unknown, computed,
nested, commented or incomplete collections still refuse; no source is executed.
Provider/key detectors continue scanning the entire payload independently.
Equality comparisons accept bounded literals, constants, and environment lookups;
bounded lookahead must establish termination, not merely a physical line end.
Diff EOF/omissions are not source EOF; ambiguous continuations still refuse.
"""

from __future__ import annotations

import ast
import bisect
import os
import re
import shlex
import stat
import sys
import warnings
from dataclasses import dataclass

REQUEST_MAX = 256 * 1024
ARTIFACT_MAX = 512 * 1024
TOTAL_MAX = 1024 * 1024
FINDING_REPORT_MAX = 8
COMPARISON_MAX_CHARS = 16384
COMPARISON_MAX_LINES = 128
COMPARISON_MAX_TOKENS = 256
COMPARISON_MAX_DEPTH = 8

PATTERN_ENVELOPE = re.compile(r"-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----")
PATTERN_PROVIDER_A = re.compile(r"\bsk-[A-Za-z0-9_-]{16,}\b")
PATTERN_PROVIDER_B = re.compile(r"\bgh[pousr]_[A-Za-z0-9]{20,}\b")
PATTERN_PROVIDER_C = re.compile(r"\bgithub_pat_[A-Za-z0-9_]{20,}\b")
PATTERN_CLOUD_ID = re.compile(r"\b(?:AKIA|ASIA)[A-Z0-9]{16}\b")
PATTERN_ASSIGNMENT = re.compile(
    r"""(?im)^[ \t+\-]*(?:export\s+)?["']?"""
    r"[A-Z0-9_]*(?:API_KEY|ACCESS_KEY|SECRET|TOKEN|PASSWORD|PASSWD|PASSPHRASE|PRIVATE_KEY)"
    r"""[A-Z0-9_]*["']?\s*[:=]\s*(.*?)\s*$"""
)
PATTERN_SAFE_VALUE = re.compile(
    r"(?i)(?:example(?:[-_ ][a-z0-9]+)*|placeholder(?:[-_ ][a-z0-9]+)*|redacted|"
    r"not[-_ ]?set|replace[-_ ]?me|change[-_ ]?me|dummy(?:[-_ ][a-z0-9]+)*|"
    r"fake(?:[-_ ][a-z0-9]+)*|test(?:[-_ ][a-z0-9]+)*|your[-_ ][a-z0-9_-]+|"
    r"\$\{[A-Z_][A-Z0-9_]*\}|\{env:[^}\r\n]+\}|<[^>\r\n]{1,80}>)"
)
# A value that is code or a configuration constant rather than a literal
# secret: a call, a command substitution, an environment lookup, a shell or
# template variable, a language constant, or a permission word.
PATTERN_CODE_VALUE = re.compile(
    r"(?i)^(?:[A-Za-z_][\w.]*\(.*|\$\(.*|`.*|os\.(?:environ|getenv)\b.*|process\.env\b.*|"
    r"System\.getenv\b.*|ENV\[.*|\$\{?[A-Za-z_]\w*.*|\{\{.*|none|null|nil|true|false|\d+|"
    r"allow|deny|ask|read|write|on|off|yes|no|enabled|disabled|required|optional)$"
)
PATTERN_URL_CREDENTIAL = re.compile(r"(?i)\b[a-z][a-z0-9+.-]*://[^\s/:@]+:([^\s@/]+)@")
# String literals inside a code value: a call or lookup is safe only when every
# quoted literal it carries is a name (an upper-case identifier), a documented
# placeholder, or a short digit-free word such as a path or key name.
PATTERN_QUOTED_LITERAL = re.compile(r"""(["'])((?:(?!\1).)*)\1""")
PATTERN_HARMLESS_LITERAL = re.compile(r"(?:[A-Z][A-Z0-9_]*|[^\d]{0,23})")
PATTERN_PACKAGE_AUTH = re.compile(r"(?im)^[ \t+\-]*//[^\r\n]*:_authToken\s*=\s*([^\s#]+)")
PATTERN_NETRC_VALUE = re.compile(r"(?im)^[ \t+\-]*password\s+(\S+)")
PATTERN_NETRC_HOST = re.compile(r"(?im)^[ \t+\-]*machine\s+\S+")
PATTERN_QUOTED = re.compile(r'"(?:[^"\\]|\\.)*"')

DIFF_HEADER_PREFIXES = (
    "diff --git ",
    "diff --cc ",
    "diff --combined ",
    "--- ",
    "+++ ",
    "rename from ",
    "rename to ",
    "rename old ",
    "rename new ",
    "copy from ",
    "copy to ",
)
GIT_C_ESCAPES = {"a": "\a", "b": "\b", "t": "\t", "n": "\n", "v": "\v", "f": "\f", "r": "\r", '"': '"', "\\": "\\"}


@dataclass(frozen=True)
class Finding:
    label: str
    line: int
    rule: str


def reject(label: str, rule: str) -> None:
    print(f"SPAR-PAYLOAD REJECT: {label}: {rule}", file=sys.stderr)
    raise SystemExit(2)


def safe_code_value(value: str) -> bool:
    if not PATTERN_CODE_VALUE.fullmatch(value):
        return False
    return all(
        PATTERN_SAFE_VALUE.fullmatch(literal) or PATTERN_HARMLESS_LITERAL.fullmatch(literal)
        for _, literal in PATTERN_QUOTED_LITERAL.findall(value)
    )


def comparison_atom(value: str) -> str | None:
    """Consume one bounded atom, returning its tail, never decode source.

    Escapes are deliberately unsupported. In particular, an escaped quote must
    not expose an apparent semicolon/comment that is still inside the string.
    This stricter literal recognizer is local to the comparison exception.
    """
    literal = re.match(r'''(["'])((?:(?!\1)[^\\\r\n])*)\1''', value)
    if literal is not None:
        if (len(literal.group(2)) > 128
                or PATTERN_HARMLESS_LITERAL.fullmatch(literal.group(2)) is None):
            return None
        return value[literal.end():].strip(" \t")
    atom = re.match(r"(?:(?i:none|null|nil|true|false)|process\.env\.[A-Za-z_]\w{0,127})(?![\w.])", value)
    return None if atom is None else value[atom.end():].strip(" \t")


def safe_comparison_value(text: str, match: re.Match, in_diff: bool) -> bool:
    # The assignment matcher consumes the first '=' of '==' or '===' too.
    # This exception belongs to that source match, not to colon assignments,
    # quoted scalar values, or URL passwords that happen to begin with '='.
    prefix = text[match.start():match.start(1)]
    if not prefix.endswith("="):
        return False
    # As with path collections, bound both characters and physical lines and
    # preserve diff markers before skipping blanks/comments. A patch's final
    # addition does not establish source EOF, even at a file/hunk transition.
    marker = prefix.lstrip(" \t")[:1]
    marker = marker if marker in ("+", "-") else "+" if in_diff else None
    start = match.start(1)
    snippet = text[start:start + COMPARISON_MAX_CHARS + 1]
    lines = snippet.split("\n")
    truncated = start + len(snippet) < len(text)
    consumed = 0
    closed = False
    # Restricted grammar, implemented with a bounded expectation stack:
    #   initial RHS: atom [ ? branch : branch ]
    #   branch: atom | identifier (== | ===) atom ? branch : branch
    # Only a comparison-led conditional can nest. Bare identifiers, calls,
    # computed values and literal-truthiness conditionals are not branches.
    # Every atom retains comparison_atom's literal/constant/env checks.
    expected = ["end", "optional-conditional", "atom"]
    depth = 0
    tokens = 0

    def charge(count: int = 1) -> bool:
        nonlocal tokens
        tokens += count
        return tokens <= COMPARISON_MAX_TOKENS

    for number, line in enumerate(lines):
        consumed += len(line) + (number < len(lines) - 1)
        if number >= COMPARISON_MAX_LINES or consumed > COMPARISON_MAX_CHARS:
            return False
        if number == len(lines) - 1 and truncated:
            return False
        # Permit ordinary CRLF, never a control separator hidden inside a line
        # or comment. Split only on LF, as the assignment matcher does.
        if number < len(lines) - 1:
            line = line.removesuffix("\r")
        if re.search(r"[\x00-\x08\x0b-\x1f\x7f-\x9f\u2028\u2029]", line):
            return False
        if number and marker:
            if not line.startswith((marker, " ")):
                return False
            line = line[1:]
        if not number:
            comparison = re.match(r"={1,2}(?!=)", line)
            if comparison is None or not charge():
                return False
            line = line[comparison.end():]
        following = line.strip(" \t")
        if not following or following.startswith(("#", "//")):
            continue
        if number and not closed and expected[-1] in ("end", "optional-conditional") and re.match(
            r"(?:[A-Za-z_]\w*[ \t]*=(?!=)|(?:const|let|var|return|throw|class|function|def|import|from|pass|raise)\b)",
            following,
        ):
            # A visible next declaration/statement is termination evidence,
            # never an exemption from scanning that statement independently.
            return True
        # Bare parentheses alone are not termination: `)\n+ value` can still
        # continue. A visible closing block also terminates a semicolonless
        # return/expression. Every terminator must occupy the entire line tail;
        # same-line statements, calls, properties and casts still refuse.
        while True:
            state = expected[-1]
            if state == "finish-conditional":
                expected.pop()
                depth -= 1
                continue
            if not following or following.startswith(("#", "//")):
                break
            if state in ("atom", "branch"):
                tail = comparison_atom(following)
                if tail is None:
                    # An ordinary identifier is accepted only as the left
                    # side of another complete bounded comparison/conditional.
                    reference = re.match(r"[A-Za-z_]\w{0,127}", following) if state == "branch" else None
                    if reference is None or not charge():
                        return False
                    following = following[reference.end():].strip(" \t")
                    expected.pop()
                    expected.extend(["required-conditional", "atom", "equality"])
                    continue
                if not charge():
                    return False
                following = tail
                expected.pop()
                continue
            if state == "equality":
                equality = re.match(r"={2,3}(?!=)", following)
                if equality is None or not charge():
                    return False
                following = following[equality.end():].strip(" \t")
                expected.pop()
                continue
            if state == ":":
                if not following.startswith(":") or not charge():
                    return False
                expected.pop()
                following = following[1:].strip(" \t")
                continue
            closers = re.match(r"\)(?:[ \t]*\))*", following) if state in ("end", "optional-conditional") else None
            if closers:
                if not charge(closers.group().count(")")):
                    return False
                closed = True
                following = following[closers.end():].strip(" \t")
                continue
            if state in ("optional-conditional", "required-conditional"):
                if following.startswith("?") and not following.startswith(("??", "?.")):
                    if depth >= COMPARISON_MAX_DEPTH or not charge():
                        return False
                    following = following[1:].strip(" \t")
                    expected.pop()
                    depth += 1
                    expected.extend(["finish-conditional", "branch", ":", "branch"])
                    continue
                if state == "required-conditional":
                    return False
                expected.pop()
                continue
            if re.fullmatch(r";[ \t]*(?://[^\r\n]*)?", following):
                return charge()
            if closed and re.fullmatch(r"\{[ \t]*(?://[^\r\n]*)?", following):
                return charge()
            if re.fullmatch(r"}(?:[ \t]*})*[ \t]*(?://[^\r\n]*)?", following):
                return charge(following.split("//", 1)[0].count("}"))
            return False
    return expected in (["end"], ["end", "optional-conditional"]) and marker is None and not truncated


def safe_assignment_value(value: str) -> bool:
    stripped = value.strip().rstrip(",;")
    if safe_code_value(stripped):
        return True
    # One layer of surrounding quotes around code is still code; deeper quote
    # stripping would hide the literals the code check inspects.
    if len(stripped) >= 2 and stripped[0] in "\"'" and stripped[-1] == stripped[0] and safe_code_value(stripped[1:-1]):
        return True
    try:
        tokens = shlex.split(stripped, comments=False, posix=True)
    except ValueError:
        return False
    return not tokens or (
        len(tokens) == 1 and (tokens[0] == "" or PATTERN_SAFE_VALUE.fullmatch(tokens[0]) is not None)
    )


def sensitive_path(value: str) -> bool:
    def sensitive_component(name: str) -> bool:
        return bool(
            re.fullmatch(r"\.env(?:[._~-].*)?", name)
            or re.search(r"\.(?:key|pem|p12|pfx)(?:[._~-].*)?$", name)
            or re.fullmatch(r"secrets?(?:[._~-].*)?", name)
            or re.fullmatch(r"credentials(?:\..*)?", name)
            or re.fullmatch(r"auth\.json(?:[._~-].*)?", name)
            or re.fullmatch(r"\.(?:netrc|npmrc|pypirc)(?:[._~-].*)?", name)
            or re.fullmatch(r"id_(?:rsa|dsa|ecdsa|ed25519)(?:[._~-].*)?", name)
            or name in (".aws", ".ssh", ".gnupg", ".kube", ".mozilla", ".bash_history", ".zsh_history")
        )

    path = "/" + value.lower().strip("/") + "/"
    return any(sensitive_component(part) for part in path.split("/")) or any(
        "/" + store + "/" in path for store in (
            ".config/bravesoftware", ".config/chromium", ".local/share/keyrings",
            ".claude/.credentials.json", ".config/gh/hosts.yml", ".docker/config.json", ".hermes/config.yaml",
        )
    )


def unquote_git_path(value: str) -> str:
    """Decode one Git C-quoted path; raise ValueError on malformed quoting."""
    body = value[1:-1]
    decoded = []
    index = 0
    while index < len(body):
        character = body[index]
        if character == '"':
            raise ValueError("unescaped quote")
        if character != "\\":
            decoded.append(character)
            index += 1
            continue
        index += 1
        if index >= len(body):
            raise ValueError("truncated escape")
        escaped = body[index]
        if escaped in GIT_C_ESCAPES:
            decoded.append(GIT_C_ESCAPES[escaped])
            index += 1
            continue
        octal = body[index : index + 3]
        if len(octal) != 3 or any(digit not in "01234567" for digit in octal):
            raise ValueError("invalid escape")
        decoded.append(chr(int(octal, 8)))
        index += 3
    path = "".join(decoded)
    if "\0" in path:
        raise ValueError("NUL in path")
    return path


def diff_header_sensitive(value: str) -> bool:
    """Decide conservatively whether a diff header names a sensitive path.

    Every quoted segment, every whitespace-delimited token, and the whole value
    are checked, so a space-bearing name can only over-reject, never hide a
    sensitive component. Malformed quoting raises ValueError.
    """
    if any(ord(character) < 32 for character in value):
        raise ValueError("control character in header")
    candidates = [value]
    remainder = value
    for match in PATTERN_QUOTED.finditer(value):
        candidates.append(unquote_git_path(match.group(0)))
        remainder = remainder.replace(match.group(0), " ", 1)
    if '"' in remainder or "\\" in remainder:
        raise ValueError("malformed quoting")
    candidates.extend(value.split())
    candidates.extend(candidate[2:] for candidate in list(candidates) if candidate.startswith(("a/", "b/")))
    return any(sensitive_path(candidate) for candidate in candidates)


def decode_text(label: str, data: bytes) -> str:
    if b"\0" in data:
        reject(label, "binary content")
    try:
        return data.decode("utf-8")
    except UnicodeDecodeError:
        reject(label, "non-UTF-8 content")


def metadata_path(value: object) -> bool:
    """Recognize descriptors, not arbitrary strings or credential values."""
    if not isinstance(value, str) or re.fullmatch(r"[A-Za-z0-9_./~*?\[\]!-]{1,256}", value) is None:
        return False
    # Literal escapes/adjacent strings are decoded by the AST. A credential
    # must not acquire an exception merely by appearing within a path.
    if any(pattern.search(value) for pattern in
           (PATTERN_ENVELOPE, PATTERN_PROVIDER_A, PATTERN_PROVIDER_B, PATTERN_PROVIDER_C, PATTERN_CLOUD_ID)):
        return False
    return sensitive_path(value) or value in {".envrc", ".credentials.json"} or re.fullmatch(
        r"(?:~/)?\.[A-Za-z0-9_-]+(?:/[A-Za-z0-9_.-]+)*/config\.(?:jsonc?|ya?ml|toml)", value
    ) is not None


def collection_terminated(lines: list[str], index: int, marker: str | None, truncated: bool) -> bool:
    """A valid literal prefix is not enough inside a mapping/call's brackets.

    Require EOF, a closing outer delimiter or a clearly separate declaration.
    Operators, call/index/attribute trailers, conditional/comprehension clauses,
    omitted diff rows and other ambiguous continuations cannot close the RHS.
    """
    for number in range(index + 1, len(lines)):
        if number >= 128:
            return False
        line = lines[number]
        # Python also ends comments at CR. Do not skip a whole LF-delimited
        # comment row that can conceal code after another control separator.
        if re.search(r"[\x00-\x08\x0b-\x1f\x7f-\x9f\u2028\u2029]", line):
            return False
        if not line and number == len(lines) - 1 and not truncated:
            return True
        if marker:
            if line.startswith("diff --git "):
                return True
            if not line.startswith((marker, " ")):
                return False
            line = line[1:]
        following = line.strip()
        if not following or following.startswith("#"):
            continue
        if following[0] in ")]},":
            return True
        return re.match(
            r'''(?:["']?[A-Za-z_][A-Za-z0-9_]*["']?\s*[:=](?!=)|(?:def|class|import|from|return|pass|raise)\b)''',
            following,
        ) is not None
    return not truncated


def safe_path_collection(text: str, match: re.Match) -> bool:
    """Check the entire literal RHS, preserving raw/diff boundaries.

    No eval/literal_eval, bare-container exemption or source-file exemption.
    The AST is bounded to 16,384 source characters, 128 physical lines and 256 items;
    only flat list/tuple/set string values (or an empty mapping) are accepted.
    Diff additions may use their own prefix or explicit context, never an
    opposite-image line or an omitted-line barrier.
    """
    prefix = text[match.start():match.start(1)]
    name = re.search(r'''([A-Za-z0-9_]+)["']?\s*[:=]\s*$''', prefix)
    if not name or not re.search(r"_(?:DIRS|DIRECTORIES|FILES|FILENAMES|GLOBS|PATHS|PATTERNS|SUFFIXES|TREES)$", name[1], re.I):
        return False
    start = match.start(1)
    if text[start:start + 1] not in ("[", "(", "{"):
        return False
    marker = prefix.lstrip(" \t")[:1]
    marker = marker if marker in ("+", "-") else None
    snippet = text[start:start + 16385]
    # Match the assignment regexp's LF boundaries. splitlines() also splits
    # CR/vertical-tab/Unicode separators and could hide a suffix still captured
    # as part of this assignment's RHS.
    parts = snippet.split("\n")
    lines = [part + ("\n" if index < len(parts) - 1 else "") for index, part in enumerate(parts)]
    truncated = start + len(snippet) < len(text)
    source = ""
    for number, line in enumerate(lines):
        if number >= 128:
            return False
        if number == len(lines) - 1 and truncated and not line.endswith("\n"):
            return False
        if number and marker:
            if not line.startswith((marker, " ")):
                return False
            line = line[1:]
        if number and PATTERN_ASSIGNMENT.match(line):
            return False
        source += line
        if len(source) > 16384 or "#" in source:
            return False
        try:
            # Compiler warnings can quote untrusted source (for example an
            # invalid escape). Diagnostics must never disclose rejected bytes.
            with warnings.catch_warnings():
                warnings.simplefilter("ignore")
                node = ast.parse(source, mode="eval").body
        except SyntaxError:
            continue
        except (ValueError, RecursionError, MemoryError):
            return False
        if isinstance(node, ast.Dict) and not node.keys:
            return collection_terminated(lines, number, marker, truncated)
        if not isinstance(node, (ast.List, ast.Tuple, ast.Set)) or len(node.elts) > 256:
            return False
        return (all(isinstance(item, ast.Constant) and metadata_path(item.value) for item in node.elts)
                and collection_terminated(lines, number, marker, truncated))
    return False


def content_findings(label: str, text: str, check_paths: bool, comparison_source: str | None = None) -> list[Finding]:
    newline_offsets = [match.start() for match in re.finditer("\n", text)]
    # Outbound/reply may contain patches too. A context-line comparison after
    # a patch header must not regain raw-source EOF privileges. No patch-end
    # inference is made for subsequent prose or fragments.
    patch_header = re.search(r"(?m)^(?:diff --(?:git|cc|combined) |@@|--- |\+\+\+ )", text)

    def line_number(offset: int) -> int:
        return bisect.bisect_left(newline_offsets, offset) + 1

    # Addition-only scanning retains one LF-delimited row per input row. Use
    # original matches on those same rows solely for comparison termination:
    # visible context can close a return/conditional, but a hunk gap or opposite
    # image still cannot. Content detectors and collection checks keep their
    # existing added-line view. Require the matched value to agree before using
    # this evidence, since the assignment regexp itself can span whitespace.
    source_matches = {}
    if comparison_source is not None:
        source_newlines = [found.start() for found in re.finditer("\n", comparison_source)]
        source_matches = {bisect.bisect_left(source_newlines, found.start()) + 1: found
                          for found in PATTERN_ASSIGNMENT.finditer(comparison_source)}

    def comparison_safe(match: re.Match) -> bool:
        if comparison_source is None:
            return safe_comparison_value(text, match, patch_header is not None and patch_header.start() < match.start())
        original = source_matches.get(line_number(match.start()))
        return (original is not None and original.group(1) == match.group(1)
                and safe_comparison_value(comparison_source, original, True))

    findings: list[Finding] = []
    if check_paths:
        for number, line in enumerate(text.split("\n"), start=1):
            for prefix in DIFF_HEADER_PREFIXES:
                if not line.startswith(prefix):
                    continue
                value = line[len(prefix) :]
                if prefix in ("--- ", "+++ "):
                    value = value.split("\t", 1)[0]
                try:
                    if diff_header_sensitive(value):
                        findings.append(Finding(label, number, "sensitive-diff-path-v1"))
                except ValueError:
                    findings.append(Finding(label, number, "malformed-diff-path-v1"))
                break

    for rule, pattern in (
        ("key-envelope-v1", PATTERN_ENVELOPE),
        ("provider-a-token-v1", PATTERN_PROVIDER_A),
        ("provider-b-token-v1", PATTERN_PROVIDER_B),
        ("provider-c-token-v1", PATTERN_PROVIDER_C),
        ("cloud-access-id-v1", PATTERN_CLOUD_ID),
    ):
        for match in pattern.finditer(text):
            findings.append(Finding(label, line_number(match.start()), rule))
    for match in PATTERN_ASSIGNMENT.finditer(text):
        if (not safe_assignment_value(match.group(1))
                and not comparison_safe(match)
                and not safe_path_collection(text, match)):
            findings.append(Finding(label, line_number(match.start()), "credential-assignment-v1"))
    for match in PATTERN_URL_CREDENTIAL.finditer(text):
        if not safe_assignment_value(match.group(1)):
            findings.append(Finding(label, line_number(match.start()), "url-credential-v1"))
    for match in PATTERN_PACKAGE_AUTH.finditer(text):
        if PATTERN_SAFE_VALUE.fullmatch(match.group(1)) is None:
            findings.append(Finding(label, line_number(match.start()), "package-auth-value-v1"))
    if PATTERN_NETRC_HOST.search(text):
        for match in PATTERN_NETRC_VALUE.finditer(text):
            findings.append(Finding(label, line_number(match.start()), "netrc-value-v1"))
    return findings


def enforce(findings: list[Finding]) -> None:
    if not findings:
        return
    for finding in findings[:FINDING_REPORT_MAX]:
        print(f"SPAR-PAYLOAD FINDING: {finding.label}:{finding.line}: {finding.rule}", file=sys.stderr)
    if len(findings) > FINDING_REPORT_MAX:
        print(
            f"SPAR-PAYLOAD FINDING: {len(findings) - FINDING_REPORT_MAX} additional findings omitted",
            file=sys.stderr,
        )
    reject(findings[0].label, findings[0].rule)


def confine_artifact(path: str, roots: list[str], label: str, scratch: str | None = None) -> str:
    """Confine both the lexical and resolved paths before opening any content."""
    try:
        canonical = os.path.realpath(path, strict=True)
    except OSError:
        reject(label, "artifact does not exist")
    # A copied store must not become readable by selecting it as a root.
    for candidate in (os.path.abspath(path), canonical):
        if ".git" in candidate.split("/") or sensitive_path(candidate):
            reject(label, "artifact sits under a sensitive or Git-internal path")
        if re.match(r"^/(?:var/)?tmp/(?:opencode|claude-[^/]+|codex[^/]*)/", candidate):
            if scratch is None or not candidate.startswith(scratch + "/"):
                reject(label, "artifact belongs to another tool session, not caller scratch")
    for root in [*roots, *([scratch] if scratch else [])]:
        if canonical.startswith(root + "/"):
            return canonical
    reject(label, "artifact must live under the repository or a private caller scratch root")


def read_artifact(path: str, label: str) -> bytes:
    try:
        if not stat.S_ISREG(os.lstat(path).st_mode):
            reject(label, "artifact is not a regular file")
    except OSError:
        reject(label, "artifact does not exist")
    flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(path, flags)
    except OSError:
        reject(label, "cannot open artifact without following links")
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid() or metadata.st_nlink != 1:
            reject(label, "artifact is not a single-link regular file owned by the current user")
        with os.fdopen(descriptor, "rb", closefd=False) as stream:
            data = stream.read(ARTIFACT_MAX + 1)
    finally:
        os.close(descriptor)
    if len(data) > ARTIFACT_MAX:
        reject(label, "artifact exceeds the review limit")
    return data


def scan_outbound(arguments: list[str]) -> None:
    roots: list[str] = []
    artifacts: list[str] = []
    scratch = None
    while arguments:
        if arguments[0] == "--":
            artifacts = arguments[1:]
            break
        if arguments[0] in ("--root", "--scratch-root") and len(arguments) >= 2:
            try:
                root = os.path.realpath(arguments[1], strict=True)
                metadata = os.stat(root)
            except OSError:
                reject("root", "artifact root does not exist")
            if not stat.S_ISDIR(metadata.st_mode) or root == "/":
                reject("root", "artifact root must be a non-root directory")
            if arguments[0] == "--scratch-root":
                if (scratch is not None or not root.startswith(("/tmp/", "/var/tmp/"))
                        or re.fullmatch(r"/(?:var/)?tmp/(?:opencode|claude-[^/]+|codex[^/]*)", root)
                        or metadata.st_uid != os.getuid() or metadata.st_mode & 0o077
                        or sensitive_path(root) or ".git" in root.split("/")):
                    reject("root", "scratch root must be a private owned session directory under a temp root")
                scratch = root
            else:
                roots.append(root)
            del arguments[:2]
        else:
            reject("options", "expected --root, --scratch-root, or -- before artifact operands")
    if artifacts and not (roots or scratch):
        reject("root", "artifacts require --root or --scratch-root")
    request = sys.stdin.buffer.read(REQUEST_MAX + 1)
    if not request.strip():
        reject("request", "review request is empty")
    if len(request) > REQUEST_MAX:
        reject("request", "request exceeds the review limit")
    enforce(content_findings("request", decode_text("request", request), True))
    sections = [request.decode("utf-8")]
    total = len(request)
    for index, path in enumerate(artifacts, start=1):
        label = f"artifact {index}"
        name = os.path.basename(path)
        canonical = confine_artifact(path, roots, label, scratch)
        data = read_artifact(canonical, label)
        total += len(data)
        if total > TOTAL_MAX:
            reject("payload", "payload exceeds the aggregate review limit")
        text = decode_text(label, data)
        enforce(content_findings(label, text, True))
        sections.append(f"===== artifact: {name} =====\n{text}\n===== end artifact: {name} =====")
    sys.stdout.write("\n\n".join(sections))


def scan_stream(label: str, check_paths: bool) -> None:
    data = sys.stdin.buffer.read(TOTAL_MAX + 1)
    if len(data) > TOTAL_MAX:
        reject(label, f"{label} exceeds the review limit")
    text = decode_text(label, data)
    comparison_source = text if check_paths else None
    if check_paths:
        # A diff exposes only its headers and added lines; removed and context
        # lines already exist in the base.
        # A bare # is an omission barrier, distinct from an added +# comment or
        # an actual EOF. Never join additions across missing context or hunks.
        lines = text.split("\n")
        text = "\n".join(
            line if line.startswith(("+", "diff ", "--- ", "rename ", "copy "))
            or (number == len(lines) - 1 and not line) else "#"
            for number, line in enumerate(lines)
        )
    enforce(content_findings(label, text, check_paths, comparison_source))


def main() -> None:
    if len(sys.argv) >= 2 and sys.argv[1] == "outbound":
        scan_outbound(sys.argv[2:])
        return
    if len(sys.argv) == 2 and sys.argv[1] == "reply":
        scan_stream("reply", False)
        return
    if len(sys.argv) == 2 and sys.argv[1] == "diff":
        scan_stream("diff", True)
        return
    print("usage: spar-payload-scan outbound [--root DIR]... [--scratch-root DIR] -- [artifact-file...] | reply | diff", file=sys.stderr)
    raise SystemExit(64)


if __name__ == "__main__":
    main()
