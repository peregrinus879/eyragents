#!/usr/bin/env bash
# spar-claude - cross-vendor review: Claude Code reviews work drafted in another tool.
#
# Usage: spar-claude review [--resume SESSION] "<request>"
#
# Runs from the repository root under H's normal Claude Code settings in auto
# mode, with the auditor's tools only (read, shell, web) and no MCP tools; the
# auditor charter is appended to the system prompt, and the model is the
# moving `fable` alias. Normal settings load project configuration, so use it
# only in trusted checkouts. A review needs a clean client exit and a reply
# ending with the charter's VERDICT line. The reply goes to stdout; the session
# ID and observed model go to stderr as "SPAR-BRIDGE ID:" and "SPAR-BRIDGE MODEL:".
# Exit codes: 0 reply, 3 usage limit, 5 reviewer failure, 64 usage,
# 124 timeout (SPAR_BRIDGE_TIMEOUT seconds, default 1800), 130 interrupted.
set -euo pipefail

MODEL=fable
TOOLS=Read,Bash,WebFetch,WebSearch
TIMEOUT=${SPAR_BRIDGE_TIMEOUT:-1800}
CHARTER="$(dirname -- "$(realpath -e -- "${BASH_SOURCE[0]}")")/../../../agents/auditor.md"
LIMIT_RE="usage limit|rate limit|hit your [a-z' ]*limit|limiting requests|quota|too many requests|overloaded|429|529"
VERDICT_RE='^VERDICT: (CONVERGED|OPEN [0-9]+ BLOCKING / [0-9]+ NON-BLOCKING)$'

usage() { printf 'usage: spar-claude review [--resume SESSION] "<request>"\n' >&2; exit 64; }
fail() { printf 'SPAR-BRIDGE ERROR: %s\n' "$1" >&2; [[ -z ${2:-} ]] || tail -c 2000 <<<"$2" >&2; exit 5; }
[[ ${1:-} == review ]] || usage
shift
resume=()
if [[ ${1:-} == --resume ]]; then
  [[ -n ${2:-} ]] || usage
  resume=(--resume "$2")
  shift 2
fi
[[ $# == 1 && -n $1 ]] || usage
[[ $TIMEOUT =~ ^[1-9][0-9]*$ ]] || usage
[[ -r $CHARTER ]] || fail "auditor charter missing: $CHARTER"
repo=$(git rev-parse --show-toplevel 2>/dev/null) || { printf 'SPAR-BRIDGE ERROR: run from inside a Git worktree\n' >&2; exit 64; }

# Every client call runs in its own process group under a hard timeout; the
# group is killed when the call ends, times out or the bridge is interrupted.
work=$(mktemp -d)
pid=""
trap 'rm -rf -- "$work"' EXIT
trap '[[ -z $pid ]] || { kill -TERM -- "-$pid" 2>/dev/null || kill -TERM -- "$pid" 2>/dev/null; sleep 1; kill -KILL -- "-$pid" 2>/dev/null; }; exit 130' INT TERM HUP
supervise() { # seconds stdin stdout stderr command... ; sets rc
  (cd "$repo" && exec timeout --kill-after=10 "$1" "${@:5}") <"$2" >"$3" 2>"$4" &
  pid=$!
  rc=0
  wait "$pid" || rc=$?
  kill -KILL -- "-$pid" 2>/dev/null || true
  pid=""
}
printf '%s' "$1" >"$work/request"
supervise "$TIMEOUT" "$work/request" "$work/out" "$work/err" claude -p --permission-mode auto --model "$MODEL" \
  --effort xhigh --tools "$TOOLS" --disallowedTools 'mcp__*' --strict-mcp-config --output-format json \
  --append-system-prompt "$(<"$CHARTER")" "${resume[@]}"

if ((rc == 124 || rc == 137)); then
  printf 'SPAR-BRIDGE TIMEOUT: no reply within %ss\n' "$TIMEOUT" >&2
  exit 124
fi
result=$(jq -cR 'fromjson? | select(.type == "result")' "$work/out" | tail -n 1)
if { cat -- "$work/err"; jq -r 'select(.is_error == true) | .result // empty' <<<"$result" 2>/dev/null; } | grep -qiE "$LIMIT_RE"; then
  printf 'SPAR-BRIDGE LIMIT: the reviewer hit a usage limit\n' >&2
  exit 3
fi
reply=$(jq -r 'select(.is_error != true) | .result // empty' <<<"$result" 2>/dev/null || true)
((rc == 0)) || fail "the reviewer exited $rc" "$(<"$work/err")"
[[ -n $reply ]] || fail "the reviewer ended without a reply" "$(<"$work/err")"
printf 'SPAR-BRIDGE ID: %s\n' "$(jq -r '.session_id // "unknown"' <<<"$result")" >&2
printf 'SPAR-BRIDGE MODEL: %s\n' "$(jq -r '.modelUsage // {} | keys | join(",") | if . == "" then "unknown" else . end' <<<"$result")" >&2
grep -v '^[[:space:]]*$' <<<"$reply" | tail -n 1 | grep -qE "$VERDICT_RE" ||
  fail "the reply does not end with a VERDICT line; not a review" "$reply"
printf '%s\n' "$reply"
