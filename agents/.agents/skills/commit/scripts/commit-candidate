#!/usr/bin/env bash
# Record the prepared index; --stage explicitly stages whole intended paths.
# Usage: commit-candidate [--stage] [--message-file FILE] -- PATH...
#        commit-candidate --show ID | --clear ID
#        commit-candidate --close ID... [--dry-run] [--accept-unverified | --local-only]
# Close only explicit full IDs after all-record preflight under the existing lock.
# Committed objects must match their immutable candidates, also on recovery.
# Normal close-out requires selected eligible publication ancestry; --local-only
# validates candidate objects without publication coverage and refuses publication IDs.
# Historical commits need no current-tip/config-identity match. Ready candidates
# and ambiguous apply failures stay. Unverified publication close-out is explicit,
# not push confirmation or policy attestation. Validated closing markers can resume.
# Exact-ID .close-ID.write recovery requires a matching prefix containing the complete
# coverage proof, receipt ID and outcome. Empty/short ambiguous staging stays for H;
# orphan/mismatched/unsafe staging refuses. Unknown .write-* files are never swept.
# Preview changes no records; close retains the lock inode and never changes Git.
set -euo pipefail
exec python3 -I "$(dirname -- "$(realpath -e -- "${BASH_SOURCE[0]}")")/governance.py" candidate "$@"
